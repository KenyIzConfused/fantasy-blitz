[gd_scene format=3]
	
	[ext_resource type="ArrayMesh" path="res://assets/Models/OBJ format/tower-round-base.obj" id="1_base"]
	[ext_resource type="PackedScene" path="res://assets/Models/GLTF FORMAT/WIZARD.glb" id="2_wizard_glb"]
	[ext_resource type="Script" path="res://tower/towerScripts/wizard.gd" id="3_wizard_script"]
	
	[sub_resource type="BoxShape3D" id="WizardBaseShape"]
	size = Vector3(1, 0.24, 1)
	
	[sub_resource type="SphereShape3D" id="WizardRangeShape"]
	radius = 5.0
	debug_color = Color(0.5, 0, 0.8, 1)
	
	[node name="wizard" type="StaticBody3D"]
	transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.5, 0, 0.5)
	script = ExtResource("3_wizard_script")
	
	[node name="Base" type="MeshInstance3D" parent="."]
	transform = Transform3D(1.6, 0, 0, 0, 1, 0, 0, 0, 1.6, 0, 0, 0)
	mesh = ExtResource("1_base")
	
	[node name="Model" type="Node3D" parent="."]
	transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.336, 0)
	
	[node name="MeshInstance3D" type="MeshInstance3D" parent="Model"]
	transform = Transform3D(0.18, 0, 0, 0, 0.18, 0, 0, 0, 0.18, 0, 0, 0)
	
	[node name="WIZARDGlb" parent="Model/MeshInstance3D" instance=ExtResource("2_wizard_glb")]
	
	[node name="Aim" type="Marker3D" parent="Model/MeshInstance3D"]
	transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 8.0, 0)
	
